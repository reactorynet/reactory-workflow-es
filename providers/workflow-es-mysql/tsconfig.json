{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "./build",
        "declaration": true,
        "noImplicitAny": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": false,
        "pretty": true,
        "lib": [
            "ES2020"
        ],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "exclude": [
        "node_modules",
        "spec"
    ],
    "files": [
        "src/index.ts"
    ]
}
