{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "./build",
        "declaration": true,
        "noImplicitAny": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "lib": [
            "ES2020"
        ],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src/**/*.ts",
        "spec/**/*.ts"
    ]
}
