{
  "name": "workflow-es-mongodb",
  "version": "2.1.1",
  "description": "MongoDB provider for Workflow ES",
  "main": "./build/src/index.js",
  "typings": "./build/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "pretest": "docker pull mongo && docker run -p 27019:27017 --name workflow-es-tests -d mongo && npm run build",
    "test": "jasmine",
    "posttest": "docker kill workflow-es-tests && docker rm workflow-es-tests"
  },
  "keywords": [
    "workflow",
    "mongodb"
  ],
  "author": {
    "email": "daniel@gerlag.ca",
    "name": "Daniel Gerlag"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jasmine": "^4.6.0",
    "@types/mongodb": "^3.6.20",
    "@types/node": "^20.0.0",
    "jasmine": "^5.0.0",
    "jasmine-core": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@reactorynet/workflow-es": "file:../../core",
    "inversify": "^4.1.0",
    "json-stable-stringify": "^1.0.1",
    "mongodb": "^3.2.7",
    "reflect-metadata": "^0.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reactorynet/reactory-workflow-es.git",
    "directory": "providers/workflow-es-mongodb"
  }
}
